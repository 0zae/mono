# Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 상호명 분류에 쓸 모델. 쉼표로 여러 개 적으면 앞 모델이 막힐 때 다음 모델을 써요
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
PORT=5173
# 데이터(SQLite) 저장 위치. 비워 두면 ~/.moa
# iCloud 폴더 안에 두지 마세요. 동기화 중에 DB 파일이 깨질 수 있어요.
DATA_DIR=
